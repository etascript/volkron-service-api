# Kellu / Volkron Servicios API

# Servidor
PORT=9001
NODE_ENV=production
PUBLIC_BASE_URL=https://api.volkron.kappascript.cl

# CORS
# Usa coma para permitir mas de un origen:
# CORS_ORIGIN=https://www.volkronenergy.cl,https://volkronenergy.cl
CORS_ORIGIN=https://www.volkronenergy.cl

# SQLite y datos locales
DATABASE_PATH=./data/app.db
BACKUP_DIR=./data/quotes
STATUS_EVENTS_FILE=./data/status-events.jsonl

# Requerido. Debe ser base64 de 32 bytes.
# Generar:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=

# Feature flags
# Para Volkron debe quedar en false. Para producto comercial futuro puede ser true.
FORMS_BUILDER_ENABLED=false

# Admin / sesiones
# Requerido para firmar cookies de sesion.
# Generar:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_SESSION_SECRET=

# Valores usados solo como fallback por el comando npm run admin:create-user.
# El login real usa usuarios guardados en SQLite.
ADMIN_USER=volkron
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@volkronenergy.cl

# Alternativa explicita para crear usuarios por variables de entorno:
# ADMIN_CREATE_USERNAME=volkron
# ADMIN_CREATE_EMAIL=admin@volkronenergy.cl
# ADMIN_CREATE_PASSWORD=
# ADMIN_CREATE_NAME=Admin Volkron

# SMTP para recuperacion de clave
# Si no se configura SMTP, el link de recuperacion queda en logs como fallback de desarrollo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google Sheets legacy opcional
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Cotizaciones
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Calendario y disponibilidad
# AVAILABLE_SLOTS se usa solo como semilla legacy cuando se crea la agenda inicial
# del formulario cotizacion. Luego los horarios se editan desde /admin/schedule.
AVAILABLE_SLOTS=09:00 - 11:00,11:00 - 13:00,14:00 - 16:00,16:00 - 18:00
LOOKAHEAD_MONTHS=6

# Feriados manuales de respaldo, separados por coma.
HOLIDAYS=2026-01-01,2026-04-03,2026-04-04,2026-05-01,2026-05-21,2026-06-29,2026-07-16,2026-08-15,2026-09-18,2026-09-19,2026-10-12,2026-10-31,2026-11-01,2026-12-08,2026-12-25

# API de feriados Chile. Puede quedar vacia para usar solo HOLIDAYS.
HOLIDAYS_API_URL=https://api.roison.cl/feriados.json
HOLIDAYS_CACHE_TTL_MS=43200000
